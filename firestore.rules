rules_version = '2';

/* Rwendo — one private document per signed-in account.
   A student can only ever read or write their own record, and the
   supervisor PIN hash travels inside that same document, so it is
   never readable by anybody else either. */
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Nothing else in the project is reachable from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
